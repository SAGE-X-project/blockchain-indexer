module github.com/sage-x-project/blockchain-indexer

go 1.26.0

toolchain go1.26.11

// Go 1.26 offers SecP256r1MLKEM768 in the TLS handshake by default, and the
// public Solana RPC endpoint answers such handshakes with HTTP 403. Keep the
// Go 1.25 curve list (X25519MLKEM768 stays enabled).
godebug tlssecpmlkem=0

require (
	github.com/centrifuge/go-substrate-rpc-client/v4 v4.2.1
	github.com/cockroachdb/pebble v1.1.5
	github.com/cometbft/cometbft v0.38.26
